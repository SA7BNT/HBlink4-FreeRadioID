# NOTE: this file ships with the author's user and install paths. Change User=,
# Group=, WorkingDirectory= and ExecStart= below to match your system.
# Edit the installed copy in /etc/systemd/system/, not this one, and run
# "sudo systemctl daemon-reload" after any change. See SYSTEMD.md.
[Unit]
Description=HBlink4 Dashboard
After=network.target hblink4.service
Wants=hblink4.service

[Service]
Type=simple
User=cort
Group=cort
WorkingDirectory=/home/cort/hblink4
# N8 update guard: after an update from the web interface, go back to the previous commit
# if the dashboard does not come up three times in a row (relative to WorkingDirectory)
ExecStartPre=-/bin/sh scripts/n8-update-guard.sh . dashboard/data
ExecStart=/home/cort/hblink4/venv/bin/python /home/cort/hblink4/dashboard/server.py
Restart=always
RestartSec=10
# Stop must never hang (background downloads are abandoned, data is saved first)
TimeoutStopSec=20

# Security hardening
# NOTE: do not add PrivateTmp=true here. See the note in hblink4.service --
# a private /tmp breaks the 'unix' event transport between the two services.
NoNewPrivileges=true

# HTTPS (dashboard/config.json -> https): lets the dashboard listen on ports
# 80 and 443 without running as root. Harmless when HTTPS is off.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hblink4-dash

[Install]
WantedBy=multi-user.target
